@model Atlas.Models.Entities.ProductType

@{
    ViewData["Title"] = "Desactivar Tipo de Producto";
}

<h1>Desactivar Tipo de Producto</h1>

<h3>¿Está seguro que desea desactivar este tipo de producto?</h3>

@if (ViewBag.ProductCount > 0)
{
    <div class="alert alert-warning">
        <strong>Atención:</strong> Este tipo de producto tiene <strong>@ViewBag.ProductCount producto(s)</strong> asociado(s).
        Los productos existentes conservarán su referencia a este tipo de producto.
    </div>
}

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Description)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Description)
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="ProductTypeId" />
        <input type="submit" value="Desactivar" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>
