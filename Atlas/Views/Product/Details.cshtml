@model Atlas.Models.Entities.Product

@{
    ViewData["Title"] = "Detalles del Producto";
}

<h1>Detalles del Producto</h1>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Nombre</dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
        <dt class="col-sm-2">Descripción</dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Description)
        </dd>
        <dt class="col-sm-2">Código interno</dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.InternalCode)
        </dd>
        <dt class="col-sm-2">Marca</dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Brand!.Name)
        </dd>
        <dt class="col-sm-2">Tipo de producto</dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.ProductType!.Name)
        </dd>
        <dt class="col-sm-2">Creado</dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.CreatedAt)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model.ProductId" class="btn btn-warning">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver al Listado</a>
</div>
